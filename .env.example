# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DEVBLOG (TEMPLATE MẪU)
# Tạo bản sao file này đặt tên là .env và điền thông tin thật.
# ==========================================

# Môi trường chạy: 'development' | 'production' | 'testing'
FLASK_ENV=development
SECRET_KEY=your-random-secret-key-here

# ==========================================
# CẤU HÌNH DATABASE
# ==========================================
# 1. SQLite (Phát triển local):
# DATABASE_URL=sqlite:///instance/blog.db

# 2. PostgreSQL (Supabase / Render / Neon / Cloud):
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ==========================================
# CẤU HÌNH GMAIL GỬI EMAIL (Flask-Mail)
# ==========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=DevBlog <your-email@gmail.com>

# URL website (dùng tạo link xác thực / thông báo trong email)
SITE_URL=http://127.0.0.1:5000

# ==========================================
# LỊCH GỬI BẢN TIN DIGEST HÀNG NGÀY
# ==========================================
# Giờ UTC (Việt Nam = UTC+7). Ví dụ 8:00 sáng VN = 01:00 UTC
DAILY_DIGEST_HOUR_UTC=1
DAILY_DIGEST_MINUTE_UTC=0
